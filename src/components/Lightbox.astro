<dialog class="lightbox" aria-label="Photo viewer">
	<button type="button" class="close" aria-label="Close">×</button>
	<button type="button" class="nav prev" aria-label="Previous photo">‹</button>
	<button type="button" class="nav next" aria-label="Next photo">›</button>
	<figure>
		<img alt="" />
		<figcaption class="mono">
			<span class="title"></span>
			<span class="date"></span>
			<a class="flickr" rel="noopener" target="_blank">View on Flickr ↗</a>
		</figcaption>
	</figure>
</dialog>

<script>
	const dialog = document.querySelector<HTMLDialogElement>('.lightbox')!;
	const img = dialog.querySelector<HTMLImageElement>('img')!;
	const title = dialog.querySelector<HTMLElement>('.title')!;
	const date = dialog.querySelector<HTMLElement>('.date')!;
	const link = dialog.querySelector<HTMLAnchorElement>('.flickr')!;
	const prev = dialog.querySelector<HTMLButtonElement>('.prev')!;
	const next = dialog.querySelector<HTMLButtonElement>('.next')!;

	let items: HTMLAnchorElement[] = [];
	let index = 0;

	const show = (i: number) => {
		index = (i + items.length) % items.length;
		const a = items[index];
		img.src = a.dataset.full!;
		img.alt = a.dataset.title || 'Untitled';
		title.textContent = a.dataset.title || '';
		date.textContent = a.dataset.date || '';
		link.href = a.href;
		// Warm the cache for the neighbours so paging feels instant.
		for (const n of [index - 1, index + 1]) new Image().src = items[(n + items.length) % items.length].dataset.full!;
	};

	document.addEventListener('click', (e) => {
		const a = (e.target as Element).closest<HTMLAnchorElement>('a.ph[data-full]');
		if (!a || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return; // let "open in new tab" work
		e.preventDefault();
		items = [...document.querySelectorAll<HTMLAnchorElement>(`a.ph[data-gallery="${a.dataset.gallery}"]`)].filter((x) => !x.hidden);
		prev.hidden = next.hidden = items.length < 2;
		dialog.showModal();
		show(items.indexOf(a));
	});

	prev.addEventListener('click', () => show(index - 1));
	next.addEventListener('click', () => show(index + 1));
	dialog.querySelector('.close')!.addEventListener('click', () => dialog.close());
	// Click on the dark backdrop (the dialog itself) closes it.
	dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());
	dialog.addEventListener('close', () => img.removeAttribute('src'));
	dialog.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowLeft') show(index - 1);
		if (e.key === 'ArrowRight') show(index + 1);
	});

	// Swipe left/right on touch screens.
	let startX = 0;
	dialog.addEventListener('pointerdown', (e) => (startX = e.clientX));
	dialog.addEventListener('pointerup', (e) => {
		const dx = e.clientX - startX;
		if (e.pointerType === 'touch' && Math.abs(dx) > 50 && items.length > 1) show(index + (dx < 0 ? 1 : -1));
	});
</script>

<style is:global>
	html:has(dialog.lightbox[open]) { overflow: hidden; }
</style>

<style>
	.lightbox {
		width: 100vw;
		max-width: none;
		height: 100dvh;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
		color: #fff;
	}
	.lightbox[open] { display: grid; }
	.lightbox::backdrop { background: rgb(0 0 0 / 0.96); }
	figure { margin: 0; display: grid; grid-template-rows: 1fr auto; height: 100%; min-height: 0; padding: 3.5rem 0.75rem 0.75rem; }
	img { width: 100%; height: 100%; min-height: 0; object-fit: contain; }
	figcaption { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; justify-content: center; padding-top: 0.75rem; color: #cfcfca; }
	.title { color: #fff; }
	a { color: inherit; text-underline-offset: 0.2em; }
	a:hover { color: var(--accent); }

	button {
		position: absolute;
		z-index: 1;
		display: grid;
		place-items: center;
		width: 3rem;
		height: 3rem;
		border: 0;
		border-radius: 50%;
		background: rgb(255 255 255 / 0.1);
		color: #fff;
		font-size: 1.75rem;
		line-height: 1;
		cursor: pointer;
	}
	button:hover { background: rgb(255 255 255 / 0.22); }
	button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
	button[hidden] { display: none; }
	.close { top: 0.5rem; right: 0.5rem; }
	.nav { top: 50%; transform: translateY(-50%); }
	.prev { left: 0.5rem; }
	.next { right: 0.5rem; }
	@media (max-width: 40rem) { .nav { top: auto; bottom: 3.5rem; transform: none; } }
</style>
