---
import { getImage } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import SubNav from '../../../components/SubNav.astro';
import Cover from '../../../components/Cover.astro';
import ListenLinks from '../../../components/ListenLinks.astro';
import { getAlbums, albumUrl, coverOf, formatWeek } from '../../../lib/albums';

export async function getStaticPaths() {
	const albums = await getAlbums();
	return albums.map((album, i) => ({
		params: { slug: album.id },
		props: { album, newer: albums[i - 1], older: albums[i + 1] },
	}));
}

const { album, newer, older } = Astro.props;
const { title, artist, weekOf, year, tags, highlights, links, blurb } = album.data;
const paragraphs = (blurb ?? '').split(/\n\s*\n/).filter(Boolean);
const cover = coverOf(album);
const preview = cover ? (await getImage({ src: cover, width: 1200, height: 1200 })).src : undefined;
---

<Base title={`${title} · ${artist}`} description={`${title} by ${artist}, album of the week.`} image={preview}>
	<SubNav />
	<article class="album">
		<div class="art"><Cover album={album} size={1000} eager /></div>
		<div class="info">
			<p class="mono meta">
				Week of {formatWeek(weekOf)}
			</p>
			<h1>{title}</h1>
			<p class="artist">{artist}{year && <span class="year"> · {year}</span>}</p>
			{tags.length > 0 && <p class="tags">{tags.map((t) => <span class="badge">{t}</span>)}</p>}
			{paragraphs.length > 0 && <div class="prose">{paragraphs.map((p) => <p>{p}</p>)}</div>}
			{
				highlights.length > 0 && (
					<>
						<h2 class="mono tracks-label">Standout tracks</h2>
						<ul class="tracks">{highlights.map((h) => <li>{h}</li>)}</ul>
					</>
				)
			}
			<ListenLinks {...links} name={title} />
		</div>
	</article>

	<nav class="pager mono" aria-label="Other albums">
		{older ? <a href={albumUrl(older)}>← {older.data.title}</a> : <span />}
		<a href="/music/">All albums</a>
		{newer ? <a href={albumUrl(newer)}>{newer.data.title} →</a> : <span />}
	</nav>
</Base>

<style>
	.album { display: grid; gap: 1.5rem; }
	.art { max-width: 32rem; }
	h1 { font-size: clamp(2rem, 7vw, 3.25rem); }
	.meta { color: var(--muted); margin: 0 0 0.75rem; }
	.artist { font-size: 1.25rem; margin: 0 0 1rem; }
	.year { color: var(--muted); }
	.tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
	.tracks-label { margin: 1.5rem 0 0.5rem; font-size: 0.8rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
	.tracks { margin: 0; padding-left: 1.1rem; }
	.tracks li { margin: 0.15rem 0; }
	.pager { display: flex; justify-content: space-between; gap: 1rem; margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--line); }
	.pager a { text-decoration: none; }
	.pager a:hover { color: var(--accent); }
	@media (min-width: 48rem) {
		.album { grid-template-columns: minmax(16rem, 28rem) 1fr; gap: 3rem; align-items: start; }
	}
</style>
